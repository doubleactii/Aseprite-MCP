{
  "name": "aseprite-mcp-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, authenticated AI bridge for Aseprite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p server && node scripts/generate.mjs",
    "test": "npm run build && node --test server/test/*.test.mjs",
    "setup": "npm run build && node server/build/setup.js",
    "start": "node server/build/index.js",
    "doctor": "node server/build/setup.js --doctor",
    "package": "npm run build && node scripts/package.mjs",
    "test:aseprite": "npm run build && node scripts/test-aseprite.mjs",
    "runtime": "node scripts/fetch-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "fflate": "^0.8.2"
  }
}
